*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.spec

# 3. Приватные данные пользователей и резервные копии (Zero-Leak Policy)
backups/
*.tar.gz
*.tgz
*.tar
*.zip
*.7z
*.agybak
*.bak
*.orig
*.tmp

# 4. Базы данных диалогов, журналы WAL и Protobuf состояния
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.pbtxt
*.pb
conversations/
brain/

