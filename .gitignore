# ==============================================================================
#                      ANTIGRAVITY TOOLKIT — GITIGNORE
#       Полная защита от утечек данных, токенов, сессий и резервных копий
# ==============================================================================

# 1. Системные файлы ОС
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 2. Python кэши и окружения
